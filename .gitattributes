# Keep copied Flockdeck assets byte-identical to their source on every platform
*.svg -text
*.woff2 binary

# Shell scripts are run by sh, which fails on a carriage return, whatever the checkout platform.
*.sh text eol=lf

# Legal texts are kept byte for byte, as Flockdeck's own are.
LICENSE text eol=lf
THIRD-PARTY-NOTICES.md text eol=lf
packaging/licenses/*.txt text eol=lf
